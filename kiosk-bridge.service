[Unit]
Description=Tablet Hardness Tester kiosk API (Flask app.py)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=rle
Group=rle
Environment=PYTHONUNBUFFERED=1
Environment=INTERNAL_USB_PATH=/media/usb_internal
Environment=STORAGE_DIR=/media/usb_internal/storage
Environment=REPORTS_DIR=/media/usb_internal/reports
Environment=AUDIT_DB_DIR=/media/usb_internal/db
Environment=INTERNAL_USB_UUIDS=C09D-FF4F
Environment=INTERNAL_USB_PKNAME=sda
Environment=INTERNAL_USB_PARTITION=/dev/sda1
Environment=SCALE_PORT=/dev/ttyAMA5
Environment=SCALE_BAUD=9600
WorkingDirectory=/opt/kiosk

ExecStartPre=/bin/bash /opt/kiosk/scripts/kiosk_harden_permissions.sh
ExecStartPre=/bin/bash /opt/kiosk/scripts/kiosk_mount_internal_usb.sh
ExecStartPre=/bin/bash /opt/kiosk/scripts/kiosk_pre_start_port.sh
ExecStartPre=/bin/bash /opt/kiosk/scripts/kiosk_rtc_boot.sh

ExecStart=/bin/bash /opt/kiosk/run_kiosk_app.sh
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

StandardOutput=append:/home/rle/kiosk_bridge.log
StandardError=append:/home/rle/kiosk_bridge.log

[Install]
WantedBy=multi-user.target
